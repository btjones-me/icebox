{
  "name": "icebox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "MOBILE_RUNTIME_TEST_PORT=4185 playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:local": "node --test tests/local-worker.test.mjs tests/local-migrations.test.mjs tests/auth-session.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs tests/local-dev-watch.test.mjs",
    "test": "npm run test:unit && npm run test:sites && npm run test:local && npm run test:runtime -- --workers=1",
    "recover:sheet": "node --env-file-if-exists=.env scripts/restore-from-sheet.mjs",
    "smoke:openai": "node --env-file-if-exists=.env scripts/smoke-openai.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "dev:backend": "node --env-file-if-exists=.env scripts/local-backend.mjs",
    "dev:app:local": "vite --config vite.local.config.ts",
    "dev:control": "node scripts/local-control-server.mjs",
    "dev:local": "node --env-file-if-exists=.env scripts/dev-local.mjs",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "heic-to": "^1.5.2",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
